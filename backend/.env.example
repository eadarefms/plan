# PostgreSQL / Neon
# لا تضع هذه القيم الحقيقية في GitHub.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# مفتاح توقيع JWT — استخدم قيمة عشوائية طويلة في Vercel
JWT_SECRET="change-this-to-a-long-random-secret-before-production"
JWT_EXPIRES_IN="8h"

# المنفذ المحلي؛ Vercel يحدد PORT تلقائيًا في الإنتاج
PORT=4000

# محليًا
CORS_ORIGIN="http://localhost:5173"
