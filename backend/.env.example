DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="https://arefplan.vercel.app"

